<Window x:Class="SoleDamProyecto.Ventanas.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portal Dirección - Home" Height="700" Width="950"
        Background="#0B0A14" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilo con efecto Hover en Amarillo para los botones del menú -->
        <Style x:Key="BotonMenuEstilo" TargetType="Button">
            <Setter Property="Background" Value="#161426"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4C3F91"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#FFC107"/>
                                <Setter TargetName="borde" Property="BorderBrush" Value="#FF9800"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0">
            <TextBlock Text="PORTAL DIRECCIÓN (ADMIN)" Foreground="#6B3FA0" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="NombreAdminLabel" Text="Director / Admin" Foreground="White" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Button x:Name="PerfilAdminBoto" Content="⚙️" Width="35" Height="35" Background="#1A1829" Foreground="White" BorderBrush="#4C3F91"/>
            </StackPanel>
        </Grid>

        <!-- Cuerpo Central: Las opciones del menú -->
        <UniformGrid Grid.Row="1" Rows="2" Columns="2" Margin="10,10">

            <!-- Opción 1: Seleccionar Días -->
            <Button x:Name="SeleccionarDiesBoto" Style="{StaticResource BotonMenuEstilo}" Margin="12" Click="SeleccionarDiesBoto_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📅" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="SELECCIONAR DÍAS" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Consulta el calendario general" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Opción 2: Solicitudes / Servicios -->
            <Button x:Name="ServicisBoto" Style="{StaticResource BotonMenuEstilo}" Margin="12" Click="ServicisBoto_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="SOLICITUDES" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Historial de peticiones generales" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Opción 3: Aprobar Solicitudes -->
            <Button x:Name="AprobarSolicitudesBoto" Style="{StaticResource BotonMenuEstilo}" Margin="12" Click="AprobarSolicitudesBoto_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="✅" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="APROBAR SOLICITUDES" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Gestiona y valida peticiones del profesorado" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Opción 4: Cargar Días F/B -->
            <Button x:Name="CargarDiasFB_Boto" Style="{StaticResource BotonMenuEstilo}" Margin="12" Click="CargarDiasFB_Boto_Click">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="CARGAR DÍAS F/B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Establece festivos y bloques en el calendario" FontSize="11" Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>

        </UniformGrid>

        <!-- Pie de página -->
        <Button x:Name="EixirAplicacioBoto" Grid.Row="2" Content="Salir de la aplicación" Width="160" Height="32" HorizontalAlignment="Right"
                Background="#221F35" Foreground="#A9A8B6" BorderBrush="{x:Null}" Cursor="Hand" Click="EixirAplicacioBoto_Click"/>
    </Grid>
</Window>