<Window x:Class="Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión" Height="800" Width="1280" MinWidth="600" MinHeight="760"
        Background="#000000" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <LinearGradientBrush x:Key="DegradadoBoton" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#9333EA" Offset="0.6"/>
            <GradientStop Color="#6366F1" Offset="1"/>
        </LinearGradientBrush>

        <!-- Marco de las cajetillas -->
        <Style x:Key="MarcoCaja" TargetType="Border">
            <Setter Property="Background" Value="#0F0F18"/>
            <Setter Property="BorderBrush" Value="#2A2B3A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Height" Value="78"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#6366F1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Texto escrito dentro de las cajetillas -->
        <Style x:Key="CajaTexto" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="26,0"/>
        </Style>

        <Style x:Key="BotonLogin" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource DegradadoBoton}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="18" Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#6366F1" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonOjo" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#C7C9E8"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Ondas decorativas de fondo -->
        <Path Stroke="#2B2680" StrokeThickness="1.2" Stretch="Fill" VerticalAlignment="Top"
              Margin="0,250,0,0" Height="70" Data="M0,10 C300,-10 600,40 1280,25"/>
        <Path Stroke="#2B2680" StrokeThickness="1.2" Stretch="Fill" VerticalAlignment="Top"
              Margin="0,340,0,0" Height="50" Data="M0,10 C400,0 800,40 1280,25"/>
        <Path Stroke="#2B2680" StrokeThickness="1.2" Stretch="Fill" VerticalAlignment="Bottom"
              Margin="0,0,0,180" Height="60" Data="M0,40 C400,0 800,40 1280,0"/>
        <Path Stroke="#2B2680" StrokeThickness="1.2" Stretch="Fill" VerticalAlignment="Bottom"
              Margin="0,0,0,120" Height="50" Data="M0,35 C400,0 800,30 1280,0"/>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="540">

            <!-- LOGO NUEVO -->
            <Grid HorizontalAlignment="Center" Margin="0,0,0,30">
                <Image x:Name="ImgLogo" Width="170" Height="170"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <Border Background="#1B1A4A" BorderBrush="#2B2680" BorderThickness="1"
                        CornerRadius="16" Padding="26,8" VerticalAlignment="Bottom"
                        HorizontalAlignment="Center" Margin="0,0,0,-20">
                    <TextBlock Text="PORTAL DOCENTE" Foreground="#C7C9E8" FontSize="15"
                               FontWeight="Bold"/>
                </Border>
            </Grid>

            <TextBlock Text="Iniciar sesión" Foreground="White" FontSize="44" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,30,0,6"/>
            <TextBlock Text="Accede con tu código y contraseña" Foreground="#9CA3AF" FontSize="20"
                       HorizontalAlignment="Center" Margin="0,0,0,40"/>

            <!-- CÓDIGO (solo la cajetilla) -->
            <Border Style="{StaticResource MarcoCaja}" Margin="0,0,0,28">
                <Grid>
                    <TextBox x:Name="TxtCodigo" Style="{StaticResource CajaTexto}"/>
                    <TextBlock Text="Introduce tu código" Foreground="#6B7280" FontSize="20"
                               Margin="26,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtCodigo}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- CONTRASEÑA (solo la cajetilla) -->
            <Border Style="{StaticResource MarcoCaja}" Margin="0,0,0,44">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="TxtPass" Background="Transparent" BorderThickness="0"
                                 Foreground="White" CaretBrush="White" FontSize="20"
                                 VerticalContentAlignment="Center" Padding="26,0"
                                 PasswordChanged="TxtPass_PasswordChanged"/>
                    <TextBox x:Name="TxtPassVisible" Style="{StaticResource CajaTexto}"
                             Visibility="Collapsed" TextChanged="TxtPassVisible_TextChanged"/>
                    <TextBlock x:Name="TxtPassHint" Text="Introduce tu contraseña" Foreground="#6B7280"
                               FontSize="20" Margin="26,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    <ToggleButton x:Name="BtnOjo" Grid.Column="1" Width="64" Content="&#xE7B3;"
                                  Style="{StaticResource BotonOjo}" Click="BtnOjo_Click"/>
                </Grid>
            </Border>

            <TextBlock x:Name="TxtError" Foreground="#EF4444" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,-30,0,14"/>

            <Button x:Name="BtnLogin" Content="Iniciar" Height="78"
                    Style="{StaticResource BotonLogin}" Click="BtnLogin_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
